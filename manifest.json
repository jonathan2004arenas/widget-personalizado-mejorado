{
  "name": "Buscador y Autocompletado desde Google Sheets",
  "description": "Busca un registro por ID en una pestaña de Google Sheets y autocompleta los campos coincidentes de Jotform.",
  "version": "1.0.0",
  "url": "https://jonathan2004arenas.github.io/widget-personalizado-mejorado/",
  "iframe": true,
  "settings": {
    "apiUrl": {
      "type": "text",
      "label": "URL de la API",
      "required": true
    },

    "hoja": {
      "type": "text",
      "label": "Nombre de la hoja",
      "required": true
    },

    "columnaId": {
      "type": "text",
      "label": "Nombre de la columna ID",
      "required": true
    },

    "autofillCondition": {
      "type": "checkbox",
      "label": "Autofill by condition"
    },

    "background": {
      "type": "checkbox",
      "label": "Run in the background"
    }
  }
}